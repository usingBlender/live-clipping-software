{
  "name": "Live Clipper: approved clip → upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gta-publish",
        "options": {}
      },
      "id": "f6dcb935-6174-4407-a252-c0795b7e8a97",
      "name": "Publish webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "3ca8eb94-3f60-4b9a-8d11-1d22591a5a7e"
    },
    {
      "parameters": {
        "url": "={{ $json.body.local_download_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "c686a0bc-ed3e-40c0-8f5c-fd0a5a70ac21",
      "name": "Get final video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "binaryData": true,
        "additionalFields": {
          "caption": "=✅ Ready to post\n\n{{ $('Publish webhook').item.json.body.caption }}"
        }
      },
      "id": "e427d76a-c93e-4292-a01c-d9fe550d52b5",
      "name": "Send file to phone",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        600,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "content": "## Auto-upload approved clips\nLive Clipper POSTs every event to this webhook (add its URL in Settings → Notifications → Webhooks). This flow handles `clip.approved`: it downloads the final video (signed link, no login needed) and sends it to Telegram. After your YouTube/TikTok API audits, add upload nodes after **Get final video** (binary property `data`).",
        "width": 520,
        "height": 160
      },
      "id": "7c780882-17c1-4625-92de-f4eeaa9e1d82",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "8b1f6a1e-0b7c-4f1e-9f3a-1c2d3e4f5a6b",
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "clip.approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0c6d2b9e-7a43-4d6f-8f0e-5b1a2c3d4e5f",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        120,
        0
      ]
    }
  ],
  "connections": {
    "Publish webhook": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Get final video",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Get final video": {
      "main": [
        [
          {
            "node": "Send file to phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}