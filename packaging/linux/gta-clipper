#!/bin/sh
# /usr/bin/gta-clipper - starts GTA Clipper (or opens it if it's already running)
APP=/opt/gta-clipper
if [ ! -x "$APP/.venv/bin/python" ]; then
  echo "GTA Clipper's Python environment is missing. Run: sudo $APP/setup-env.sh" >&2
  exit 1
fi
cd "$APP" && exec "$APP/.venv/bin/python" -m web "$@"
